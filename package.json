{
  "name": "spaces",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spaces — a source-available (personal use only), agent-driven SDLC orchestrator. Runs an AIDLC pipeline (specify → plan → tasks → implement → verify) with per-project sub-agents, warm agent pool, and app-wide integrations for GitHub, Jira, Confluence, and Slack.",
  "homepage": "https://github.com/rayedbajwa/spaces",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayedbajwa/spaces.git"
  },
  "bugs": {
    "url": "https://github.com/rayedbajwa/spaces/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "aidlc",
    "agentic-workflows",
    "agentic-ai",
    "ai-agents",
    "ai-development",
    "software-development",
    "sdlc",
    "sdlc-automation",
    "pipeline-orchestrator",
    "llm-orchestration",
    "spec-kit",
    "spec-driven-development",
    "claude",
    "anthropic",
    "pi-sdk",
    "developer-tools",
    "kanban",
    "typescript",
    "bun",
    "postgres"
  ],
  "bin": {
    "spaces": "./src/cli.ts"
  },
  "scripts": {
    "build:web": "bun run src/build-web.ts",
    "aidlc": "bun run src/cli.ts",
    "web": "bun run src/server.ts",
    "worker": "bun run src/worker.ts",
    "supervisor": "bun run src/supervisor.ts",
    "standalone": "bun run src/standalone.ts",
    "setup:browsers": "bun run scripts/setup-browsers.ts",
    "e2e": "bun run scripts/e2e-pipelines.ts",
    "dev": "bun --hot src/server.ts",
    "help": "bun run src/cli.ts --help",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres && docker compose exec postgres sh -c 'until pg_isready -U aidlc -d aidlc; do sleep 1; done'",
    "db:down": "docker compose down",
    "db:migrate": "bun run src/db-migrate.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@playwright/cli": "^0.1.21",
    "@the-agency/pi-spec-kit": "^0.2.5",
    "marked": "^14.1.2",
    "pg-boss": "^12.31.0",
    "pi-playwright": "^0.1.1",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.2"
  }
}
