# ==============================================================================
# Spaces — environment variables
# ==============================================================================
# Copy this file to `.env` and fill in the values you need. `.env` is
# gitignored. See README.md for a walkthrough of each variable.
# ==============================================================================

# ---- Required ----------------------------------------------------------------

# Postgres connection string. Matches the credentials in docker-compose.yml.
DATABASE_URL=postgres://aidlc:aidlc@localhost:5432/aidlc

# 32+ character random string used to derive the AES-256-GCM key that
# encrypts stored OAuth tokens at rest. Generate one with:
#   openssl rand -base64 48
# Rotating this invalidates every previously-stored OAuth token — users must
# reconnect all integrations.
ENCRYPTION_KEY=

# LLM API key used by every agent step. At least one of these is required.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---- Optional ----------------------------------------------------------------

# HTTP port for the web UI + API. Defaults to 3000.
# PORT=3000

# Human-readable worker identity string logged with every claimed job.
# Only useful when running multiple worker processes on the same DB.
# WORKER_ID=worker-1

# How many jobs one worker process runs at once (across projects; each project
# is still limited by its own max_concurrent). Defaults to 4.
# WORKER_MAX_CONCURRENT_JOBS=4

# ---- Per-project workers (bun run src/supervisor.ts) -------------------------
# Instead of one shared worker, the supervisor spawns a dedicated worker for
# each project that has jobs and lets it exit when idle. These tune it:
# SUPERVISOR_MAX_WORKERS=4          # cap on concurrent per-project workers (each ~300-500 MB)
# WORKER_IDLE_EXIT_SECONDS=300      # idle time before a project worker exits
# (WORKER_PROJECT_ID / WORKER_SUPERVISED are set by the supervisor itself.)

# ---- Integrations (OAuth) ----------------------------------------------------
# Each integration is optional. Leave blank to disable — the Integrations panel
# will show "not configured" for that provider. To enable one, register an
# OAuth app with the provider, set the callback URL to:
#   http://<your-host>:<port>/api/oauth/<provider>/callback
# and paste the CLIENT_ID + CLIENT_SECRET below.

# GitHub OAuth app: https://github.com/settings/developers
# Scopes requested: repo, read:org, read:user
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Atlassian OAuth app (Jira + Confluence share the same client):
#   https://developer.atlassian.com/console/myapps/
# Scopes: read/write jira-work, read/write confluence-content, offline_access
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Slack OAuth app: https://api.slack.com/apps
# Scopes: channels:read, chat:write, users:read
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Linear OAuth app: https://linear.app/settings/api/applications
# Scopes: read, write. Callback: http://<your-host>:<port>/api/oauth/linear/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# ---- Workspace -------------------------------------------------------------
# Where GitHub-hosted project repos are cloned so runs can target them.
# Defaults to ~/.aidlc/workspaces/<owner>/<name>.
# AIDLC_WORKSPACE_ROOT=

# Governing workspace per project (specs, memory, knowledge, reports) — the
# project's primary repo so no code repo must be selected up front.
# AIDLC_GOVERNANCE_WORKSPACE=1        # set 0 to keep specs inside the app repo
# AIDLC_GOVERNANCE_ROOT=              # defaults to <workspace root>/_governance
