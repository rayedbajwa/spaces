# ==============================================================================
# Spaces — environment variables
# ==============================================================================
# Copy this file to `.env` and fill in the values you need. `.env` is
# gitignored. See README.md for a walkthrough of each variable.
# ==============================================================================

# ---- Required ----------------------------------------------------------------

# Postgres connection string. Matches the credentials in docker-compose.yml.
DATABASE_URL=postgres://aidlc:aidlc@localhost:5432/aidlc

# 32+ character random string used to derive the AES-256-GCM key that
# encrypts stored OAuth tokens at rest. Generate one with:
#   openssl rand -base64 48
# Rotating this invalidates every previously-stored OAuth token — users must
# reconnect all integrations.
ENCRYPTION_KEY=

# LLM provider keys (Anthropic, OpenAI, OpenRouter) are NOT set here. Add them
# in the app under Organization → Models; they are stored encrypted with
# ENCRYPTION_KEY and verified against the provider when saved.

# ---- Optional ----------------------------------------------------------------

# Build identity reported by `GET /api/version`. These are build-time metadata
# (not secrets): `SPACES_VERSION` is the release label and `GIT_COMMIT` the
# source revision the running artifact was built from. They are normally baked
# into the image via `--build-arg` (or `docker compose` build args) so packaged
# deployments report the exact source even without Git history; setting them in
# the runtime environment overrides that baked value (useful for local/dev).
#
# Resolution precedence:
#   version: SPACES_VERSION (trimmed) -> package.json "version" -> "unknown"
#   commit:  GIT_COMMIT     (trimmed) -> RAILWAY_GIT_COMMIT_SHA (platform) -> git rev-parse HEAD -> "unknown"
#
# SPACES_VERSION=1.2.3
# GIT_COMMIT="$(git rev-parse HEAD)"

# HTTP port for the web UI + API. Defaults to 3000.
# PORT=3000

# Public origin users reach the app at, when it runs behind a TLS-terminating
# proxy or platform (Railway, Fly, Render, Cloud Run). Used for OAuth callback
# URLs, GitHub App manifests and invite links. Without it the standard
# X-Forwarded-Proto / X-Forwarded-Host headers are honoured.
# PUBLIC_URL=https://spaces.example.com

# Human-readable worker identity string logged with every claimed job.
# Only useful when running multiple worker processes on the same DB.
# WORKER_ID=worker-1

# How many jobs one worker process runs at once (across projects; each project
# is still limited by its own max_concurrent). Defaults to 4.
# WORKER_MAX_CONCURRENT_JOBS=4

# ---- Per-project workers (bun run src/supervisor.ts) -------------------------
# Instead of one shared worker, the supervisor spawns a dedicated worker for
# each project that has jobs and lets it exit when idle. These tune it:
# SUPERVISOR_MAX_WORKERS=4          # cap on concurrent per-project workers (each ~300-500 MB)
# WORKER_IDLE_EXIT_SECONDS=300      # idle time before a project worker exits
# (WORKER_PROJECT_ID / WORKER_SUPERVISED are set by the supervisor itself.)
# Single-service platforms (Railway): `bun run src/standalone.ts` runs the web
# server and the supervisor together so they share one /data volume.

# ---- Authentication & teams --------------------------------------------------
# Sign-in is on by default: the first account becomes owner of the default
# team; afterwards registration is by invite link (or open it up below).
# AUTH_DISABLED=1            # no sign-in at all (single-user local use)
# OPEN_REGISTRATION=1        # anyone may register (default: invite only)
# DEFAULT_TEAM_NAME=Default team
# DEFAULT_ORG_NAME=Organization
#
# "Continue with GitHub" identifies people for the whole site, so it uses one
# GitHub OAuth app that belongs to the deployment, never an organization's
# integration app. Register an OAuth app on GitHub with the callback
# <your origin>/api/oauth/github/callback and put its credentials here; without
# both, the button is not offered and people sign in with email and password.
# GITHUB_SIGNIN_CLIENT_ID=
# GITHUB_SIGNIN_CLIENT_SECRET=

# ---- Integrations --------------------------------------------------------------
# No variables. OAuth app credentials (client id + secret) for GitHub, Atlassian
# (Jira + Confluence), Linear and Slack are entered in the app under
# Organization → Integrations by a team owner/admin and stored encrypted with
# ENCRYPTION_KEY. Each card shows the callback URL and scopes to register.

# ---- What agents may use when they build and test ---------------------------
# Agents prepare each checkout and run its tests. They are told what this
# machine offers: Docker (only when a daemon answers — set DOCKER_HOST or mount
# /var/run/docker.sock), psql, a headless Chromium, a free port for the app
# under test, and a Postgres database created for the checkout.
# That database is created on DATABASE_URL's server unless you point agents at
# a different one here, which is what to do when the main server holds data
# agents should not reach.
# AGENT_DATABASE_URL=
# DOCKER_HOST=

# ---- Workspace -------------------------------------------------------------
# Where GitHub-hosted project repos are cloned so runs can target them.
# Defaults to ~/.aidlc/workspaces/<owner>/<name>.
# AIDLC_WORKSPACE_ROOT=

# Governing workspace per project (specs, memory, knowledge, reports) — the
# project's primary repo so no code repo must be selected up front.
# AIDLC_GOVERNANCE_WORKSPACE=1        # set 0 to keep specs inside the app repo
# AIDLC_GOVERNANCE_ROOT=              # defaults to <workspace root>/_governance
